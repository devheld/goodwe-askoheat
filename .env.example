# GoodWe inverter (local Modbus TCP - requires GoodWe support to enable
# Modbus/TCP on the data logger; see README for background)
GOODWE_HOST=192.168.68.50
GOODWE_PORT=502
GOODWE_SLAVE_ID=247

# AskoHeat (Modbus TCP)
ASKOHEAT_HOST=192.168.68.73
ASKOHEAT_PORT=502
ASKOHEAT_STEP_REGISTER=200
ASKOHEAT_LOAD_REGISTER=110
ASKOHEAT_TEMP_REGISTER=325
ASKOHEAT_SLAVE_ID=1
ASKOHEAT_DELAY_S=10

# Control parameters
STEP_MIN=0
STEP_MAX=7
POLL_INTERVAL_S=60
ZERO_THRESHOLD_KW=0.05
# A new heating cycle only starts while the AskoHeat is at or below this
# temperature - once running it's left to the device's own (higher) limit.
HEATING_START_MAX_TEMP_C=55

# Battery priority: the battery is charged first and heating only starts
# once it has reached BATTERY_FULL_SOC_PCT. A running heating cycle keeps
# going until the SOC drops below BATTERY_KEEP_HEATING_SOC_PCT (hysteresis,
# since the heater's own load is what pulls the SOC back down).
BATTERY_FULL_SOC_PCT=95
BATTERY_KEEP_HEATING_SOC_PCT=90
# With a full battery the surplus is exported, so the heater regulates
# against feed-in: a step is only added while at least this much is being
# exported (the AskoHeat's smallest step is ~600W).
SURPLUS_STEP_MARGIN_KW=0.6

# History database location
DB_PATH=data/askoheat.db

# GoodWe AC EV charger (2nd gen), read-only - leave WALLBOX_HOST empty to
# hide the wallbox panel. Device id is 247 and Modbus TCP has to be enabled
# in the SolarGo app under Communication -> Wallbox. The box accepts only
# two concurrent Modbus sessions and the SEMS cloud usually holds one.
WALLBOX_HOST=192.168.1.172
WALLBOX_PORT=502
WALLBOX_SLAVE_ID=247

# Electricity tariff, used only to put a price next to the kWh on the
# energy page - nothing in the control loop reads these. Import is what a
# bought kWh costs, export what a fed-in kWh earns. Self-consumed solar is
# valued at the import price, because that is the purchase it avoided.
PRICE_IMPORT_CHF_PER_KWH=0.25
PRICE_EXPORT_CHF_PER_KWH=0.10

# Usable battery capacity in kWh. The energy page needs it to tell a
# round-trip loss from energy that simply has not been taken out again yet:
# over a few hours most of what went in is still in there, and without this
# the battery would read as a 80% loss every morning. Nothing exposes the
# figure over Modbus, so derive it from a charge that ran between two known
# SOC values: kWh moved / (SOC change / 100).
BATTERY_CAPACITY_KWH=27

# The charger is polled on its own clock. It allows two Modbus sessions, the
# SEMS cloud holds one, and the second is shared with whatever you use
# yourself (SolarGo app, evcc). This reader connects, reads and disconnects
# each time, so the slot is free between polls.
WALLBOX_POLL_INTERVAL_S=300

# Reading any register interrupts a charge in progress on this hardware (the
# current drops to 0 A for about two minutes), so the poll is skipped while a
# car is drawing. Household load above the heater counts as the car; this is
# the threshold. Keep it above the house base load and below a three-phase
# car at its 6 A minimum of 4.14 kW. See README section 7.
WALLBOX_BUSY_LOAD_KW=3.0

# Ticks the load must stay low before a charge counts as finished. One quiet
# tick is not the end of a charge - it may be a pause, and reading into a
# pause is what stops the car coming back. Five ticks of 70s outlasts the
# longest pause measured here (2.3 min) by more than double.
WALLBOX_IDLE_TICKS=5

# Poll interval once a car is on the cable, charging or parked. Parked there
# is nothing to catch; charging below the threshold above (a single-phase car
# at 6 A draws 1.38 kW) the interval is the only brake left.
WALLBOX_IDLE_POLL_INTERVAL_S=1200

# Which of the two reading strategies runs.
#   gated  - the charger is left alone while the household load says a car
#            is drawing. Everything above applies. This is the safe one.
#   direct - the charger is read every WALLBOX_POLL_INTERVAL_S whatever the
#            house is doing, which is how this ran before the fault was
#            found. A charge can be cut short while this is on.
# "direct" is a test rather than a setting to leave on: the fault is the
# charger's own, so a firmware change can end it, and reading again is the
# only way to find out. Anything unrecognised falls back to "gated".
# See README section 7.
WALLBOX_POLL_MODE=gated

# Shelly 3EM clamp meters, read over HTTP. Read-only, no authentication
# needed on firmware v1.14. The sign handling lives in shelly_client.py.
# Three clamp meters, one per question, each one optional - an empty host
# leaves that meter out. What a meter is for is the name it is configured
# under: the name decides the sign it is read with and the database columns
# it fills, so the three series can never be mistaken for one another.
#   GRID     - the three main phases. The independent check on the
#              inverter's own numbers, and the only measurement here of the
#              RMS current through the main fuse.
#   HEATPUMP - the heat pump's feed. The largest load in the house and the
#              one nothing else measures.
#   WALLBOX  - the charger's feed, measured from outside. This is what makes
#              the charger's own registers unnecessary while a car draws,
#              which is the fault of README section 7.
# At GRID the sign follows the project: export positive. At the two loads
# consumption is positive, and a negative reading means a clamp is on
# backwards. SHELLY_HOST is the old name of the grid meter and still works.
SHELLY_GRID_HOST=192.168.1.229
SHELLY_HEATPUMP_HOST=
SHELLY_WALLBOX_HOST=
SHELLY_PORT=80
SHELLY_TIMEOUT_S=3

# One label per connected MPPT input, in order, comma separated. How many
# entries there are is how many inputs the dashboard shows - that is a fact
# about the roof, not something to infer from a night-time reading of zero.
# Which side an input is on is in no register either: it is read off the
# daily curve, where the side that peaks before solar noon faces east. Left
# empty, the dashboard says "String 1" and "String 2" and claims nothing.
PV_STRING_NAMES=North-East,South-West
