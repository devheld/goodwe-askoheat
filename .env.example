# GoodWe inverter (local Modbus TCP - requires GoodWe support to enable
# Modbus/TCP on the data logger; see README for background)
GOODWE_HOST=192.168.68.50
GOODWE_PORT=502
GOODWE_SLAVE_ID=247

# AskoHeat (Modbus TCP)
ASKOHEAT_HOST=192.168.68.73
ASKOHEAT_PORT=502
ASKOHEAT_STEP_REGISTER=200
ASKOHEAT_LOAD_REGISTER=110
ASKOHEAT_TEMP_REGISTER=325
ASKOHEAT_SLAVE_ID=1
ASKOHEAT_DELAY_S=10

# Control parameters
STEP_MIN=0
STEP_MAX=7
POLL_INTERVAL_S=60
ZERO_THRESHOLD_KW=0.05
# A new heating cycle only starts while the AskoHeat is at or below this
# temperature - once running it's left to the device's own (higher) limit.
HEATING_START_MAX_TEMP_C=55

# Battery priority: the battery is charged first and heating only starts
# once it has reached BATTERY_FULL_SOC_PCT. A running heating cycle keeps
# going until the SOC drops below BATTERY_KEEP_HEATING_SOC_PCT (hysteresis,
# since the heater's own load is what pulls the SOC back down).
BATTERY_FULL_SOC_PCT=95
BATTERY_KEEP_HEATING_SOC_PCT=90
# With a full battery the surplus is exported, so the heater regulates
# against feed-in: a step is only added while at least this much is being
# exported (the AskoHeat's smallest step is ~600W).
SURPLUS_STEP_MARGIN_KW=0.6

# History database location
DB_PATH=data/home-energy.db

# GoodWe AC EV charger (2nd gen), read-only - leave WALLBOX_HOST empty to
# hide the wallbox panel. Device id is 247 and Modbus TCP has to be enabled
# in the SolarGo app under Communication -> Wallbox. The box accepts only
# two concurrent Modbus sessions and the SEMS cloud usually holds one.
WALLBOX_HOST=192.168.1.xxx
WALLBOX_PORT=502
WALLBOX_SLAVE_ID=247

# Electricity tariff, used only to put a price next to the kWh on the
# energy page - nothing in the control loop reads these. Import is what a
# bought kWh costs, export what a fed-in kWh earns. Self-consumed solar is
# valued at the import price, because that is the purchase it avoided.
PRICE_IMPORT_CHF_PER_KWH=0.25
PRICE_EXPORT_CHF_PER_KWH=0.10

# The tariff history: a year, the import price, the export price, comma
# separated. The utility publishes once a year, so the key is a year and
# not a date. A counter that runs for years has to price each kWh at the
# rate that was in force when it was used - otherwise every new tariff
# sheet silently rewrites last year's savings. The PRICE_* above remain
# the fallback for years before the first entry here, and for an
# installation that does not care to keep a history.
#   TARIFFS=2026:0.28:0.11,2027:0.25:0.10
TARIFFS=

# The date feed-in was permitted from, if it was not permitted from the
# start. Before it, surplus could not be sold at any price - it went into
# the battery, into the hot water, or was thrown away by the inverter - so
# the benchmark does not expect export revenue for those days. Scoring an
# installation against revenue it was not allowed to earn would be
# measuring the paperwork. Blank means export was always permitted.
EXPORT_ALLOWED_FROM=

# How many recorded days inside the comparison window before the benchmark
# shows a ratio. A percentage from four days of November is noise with a
# decimal point, and printing one teaches the reader to ignore it.
BENCHMARK_MIN_DAYS=30

# How a year's yield spreads over the months, twelve proportional shares
# starting with January. The quote states one annual figure, and a window
# that is November only cannot be compared against a twelfth of it -
# November is dark, and the ratio would read as a fault in the roof. The
# default is a Swiss Mittelland profile; PVGIS gives better numbers for a
# specific roof and orientation. Normalised on load, so the values only
# have to be proportional. Once a full year is recorded it stops mattering.
BENCHMARK_MONTHLY_SHARES=

# Usable battery capacity in kWh. The energy page needs it to tell a
# round-trip loss from energy that simply has not been taken out again yet:
# over a few hours most of what went in is still in there, and without this
# the battery would read as a 80% loss every morning. Nothing exposes the
# figure over Modbus, so derive it from a charge that ran between two known
# SOC values: kWh moved / (SOC change / 100).
BATTERY_CAPACITY_KWH=27

# The charger is polled on its own clock. It allows two Modbus sessions, the
# SEMS cloud holds one, and the second is shared with whatever you use
# yourself (SolarGo app, evcc). This reader connects, reads and disconnects
# each time, so the slot is free between polls.
WALLBOX_POLL_INTERVAL_S=300

# Reading any register interrupts a charge in progress on this hardware (the
# current drops to 0 A for about two minutes), so the poll is skipped while a
# car is drawing. Household load above the heater counts as the car; this is
# the threshold. Keep it above the house base load and below a three-phase
# car at its 6 A minimum of 4.14 kW. See README section 7.
WALLBOX_BUSY_LOAD_KW=3.0

# Ticks the load must stay low before a charge counts as finished. One quiet
# tick is not the end of a charge - it may be a pause, and reading into a
# pause is what stops the car coming back. Five ticks of 70s outlasts the
# longest pause measured here (2.3 min) by more than double.
WALLBOX_IDLE_TICKS=5

# Poll interval once a car is on the cable, charging or parked. Parked there
# is nothing to catch; charging below the threshold above (a single-phase car
# at 6 A draws 1.38 kW) the interval is the only brake left.
WALLBOX_IDLE_POLL_INTERVAL_S=1200

# Which of the two reading strategies runs.
#   gated  - the charger is left alone while the household load says a car
#            is drawing. Everything above applies. This is the safe one.
#   direct - the charger is read every WALLBOX_POLL_INTERVAL_S whatever the
#            house is doing, which is how this ran before the fault was
#            found. A charge can be cut short while this is on.
# "direct" is a test rather than a setting to leave on: the fault is the
# charger's own, so a firmware change can end it, and reading again is the
# only way to find out. Anything unrecognised falls back to "gated".
# See README section 7.
WALLBOX_POLL_MODE=gated

# Shelly 3EM clamp meters, read over HTTP. Read-only, no authentication
# needed on firmware v1.14. The sign handling lives in shelly_client.py.
# Three clamp meters, one per question, each one optional - an empty host
# leaves that meter out. What a meter is for is the name it is configured
# under: the name decides the sign it is read with and the database columns
# it fills, so the three series can never be mistaken for one another.
#   GRID     - the three main phases. The independent check on the
#              inverter's own numbers, and the only measurement here of the
#              RMS current through the main fuse.
#   HEATPUMP - the heat pump's feed. The largest load in the house and the
#              one nothing else measures.
#   WALLBOX  - the charger's feed, measured from outside. This is what makes
#              the charger's own registers unnecessary while a car draws,
#              which is the fault of README section 7.
# At GRID the sign follows the project: export positive. At the two loads
# consumption is positive, and a negative reading means a clamp is on
# backwards. SHELLY_HOST is the old name of the grid meter and still works.
# The main fuse, amps per phase, and the share of it that counts as close.
# Zero hides the card. Nothing here protects anything - the fuse does that -
# it only makes the distance to it visible before another load is added. The
# clamp at the house connection is the only instrument that sees phase
# current; the inverter reports load per phase, not what the connection
# carries.
MAIN_FUSE_A=0
MAIN_FUSE_WARN_PCT=80

SHELLY_GRID_HOST=192.168.1.xxx
SHELLY_HEATPUMP_HOST=
SHELLY_WALLBOX_HOST=
SHELLY_PORT=80
SHELLY_TIMEOUT_S=3

# Power on the charger's own feed, in kW, that counts as a car drawing - and
# therefore as a period in which the charger must not be read over Modbus.
# Measured standby of the GoodWe charger with nothing plugged in: 4-7 W. The
# smallest charge it can deliver: 1.38 kW. Anything between the two works;
# the default sits twenty times above standby.
WALLBOX_METER_BUSY_KW=0.1

# What the heat pump draws flat out, in kW - the ceiling of its chart's y
# axis, so the curve shows how hard the machine is working instead of being
# rescaled to whatever the busiest minute on screen happened to be. Read it
# off the nameplate (maximum electrical input, including any backup heating
# element). A peak above this lifts the axis rather than being cut off, and
# 0 leaves the axis following the data.
HEATPUMP_MAX_KW=0

# The hours the heat pump is meant to heat in, local clock, and what counts
# as its compressor running rather than its controller idling or a pump
# circulating. The window is NOT a control - nothing here can switch this
# machine, its gateway speaks no Modbus - it is the line the recorded runs
# are measured against, so "it ran at three in the morning" becomes a row
# with a timestamp. Set it to the time program the controller is on.
#
# The threshold wants to sit in the gap between idling and compressing. On
# this machine that gap is wide: 0.035 kW for the controller alone,
# 0.13-0.14 kW with only a circulation pump turning, 1.10-1.21 kW with the
# compressor running.
HEATPUMP_WINDOW_FROM_H=8
HEATPUMP_WINDOW_TO_H=18
HEATPUMP_RUN_KW=0.5

# The pump's electricity, also expressed in litres of heating oil - the
# unit this house has years of intuition in. Only the electricity is
# measured; these three turn it into litres and are printed next to the
# result, because a litre figure with its assumptions hidden is a claim
# rather than a conversion.
#
# HEATPUMP_SPF is heat delivered per kWh of electricity across a season.
# The datasheet for the CTA Optiheat 1-5es gives COP 4.5 at B0/W35, 3.4 at
# B0/W45 and 2.7 at B0/W55; the clamp's 1.10-1.21 kW is the B0/W35 column.
# 4.0 sits below that on purpose: colder brine and hot water at a higher
# flow temperature are still ahead.
HEATPUMP_SPF=4.0
# Lower heating value of heating oil, 35.9 MJ per litre.
OIL_KWH_PER_LITRE=10.0
# What an old non-condensing boiler actually put into the house across a
# year, flue and standby losses included.
OIL_BOILER_EFFICIENCY=0.85
# Delivery price per litre, for the cost line only. Swiss average was about
# 1.78 CHF/l for a 3000-6000 l delivery in late October 2026.
OIL_PRICE_CHF_PER_LITRE=1.78

# What the installation cost and what counts as earning it back. The real
# amounts belong in .env, which is not in git - an invoice is nobody's
# business but the household's. Zeros here are the "not entered yet" state,
# and the page says so instead of reporting a break-even it cannot know.
#
# INVESTMENT_CHF is the invoice total, gross, before anything came back.
INVESTMENT_CHF=0
# Real money spent on the installation that is not on that invoice - a
# wallbox bought separately, an electrician's bill paid direct. Leaving it
# out flatters the payback while the thing it paid for sits in the savings.
INVESTMENT_EXTRA_CHF=0
INVESTMENT_EXTRA_LABEL=Not on the invoice
# The grant actually paid out.
SUBSIDY_CHF=0
# A tax deduction is not cash. TAX_DEDUCTION_CHF is the amount that may be
# deducted; TAX_DEDUCTION_RATE is the share of it that became money, i.e.
# the marginal tax rate. At 1.0 the deduction is taken at face value, which
# is the optimistic reading - 0.25 to 0.30 is closer to what a deduction is
# usually worth.
TAX_DEDUCTION_CHF=0
TAX_DEDUCTION_RATE=1.0
# When the installation started earning, if that is before the first
# recorded sample. Only the recorded part is ever counted, but with this set
# the page can say what it is missing instead of starting the clock where
# the database happens to start. ISO date, e.g. 2026-06-30.
INVESTMENT_DATE=
# Which measured savings pay off the investment. Heating-instead-of-oil
# belongs in the list only if the heat pump was on the same invoice.
FINANCE_RETURN_STREAMS=pv_self,pv_export,heating

# The yardstick: what the installation was sold as doing, taken from the
# quote that led to the order, so the dashboard can answer "is it doing
# what it was supposed to" and not only "how much so far". Leave
# BENCHMARK_KWH_PER_YEAR at 0 and the comparison disappears.
#
# The quote's tariffs are kept separate from PRICE_* on purpose: a promise
# has to be compared at the prices it was made at, or the comparison
# measures the tariff instead of the roof.
BENCHMARK_LABEL=
BENCHMARK_KWP=0
BENCHMARK_KWH_PER_YEAR=0
# What the quote expected the house to use itself; the rest of the annual
# yield is what it expected to export.
BENCHMARK_SELF_KWH_PER_YEAR=0
BENCHMARK_IMPORT_CHF_PER_KWH=0
BENCHMARK_EXPORT_CHF_PER_KWH=0
# The payback the quote claimed, counted from INVESTMENT_DATE, and the net
# price it quoted.
BENCHMARK_PAYBACK_YEARS=0
BENCHMARK_NET_CHF=0

# One label per connected MPPT input, in order, comma separated. How many
# entries there are is how many inputs the dashboard shows - that is a fact
# about the roof, not something to infer from a night-time reading of zero.
# Which side an input is on is in no register either: it is read off the
# daily curve, where the side that peaks before solar noon faces east. Left
# empty, the dashboard says "String 1" and "String 2" and claims nothing.
PV_STRING_NAMES=North-East,South-West
