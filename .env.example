# SEMS / GoodWe Cloud
SEMS_ACCOUNT=you@example.com
SEMS_PASSWORD=changeme
SEMS_STATION_ID=00000000-0000-0000-0000-000000000000

# AskoHeat (Modbus TCP)
ASKOHEAT_HOST=192.168.68.73
ASKOHEAT_PORT=502
ASKOHEAT_STEP_REGISTER=200
ASKOHEAT_LOAD_REGISTER=110
ASKOHEAT_TEMP_REGISTER=325
ASKOHEAT_SLAVE_ID=1
ASKOHEAT_DELAY_S=10

# Control parameters
STEP_MIN=0
STEP_MAX=7
POLL_INTERVAL_S=60
ZERO_THRESHOLD_KW=0.01

# History database location
DB_PATH=data/askoheat.db
