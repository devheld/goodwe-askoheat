# GoodWe inverter (local Modbus TCP - requires GoodWe support to enable
# Modbus/TCP on the data logger; see README for background)
GOODWE_HOST=192.168.68.50
GOODWE_PORT=502
GOODWE_SLAVE_ID=247

# AskoHeat (Modbus TCP)
ASKOHEAT_HOST=192.168.68.73
ASKOHEAT_PORT=502
ASKOHEAT_STEP_REGISTER=200
ASKOHEAT_LOAD_REGISTER=110
ASKOHEAT_TEMP_REGISTER=325
ASKOHEAT_SLAVE_ID=1
ASKOHEAT_DELAY_S=10

# Control parameters
STEP_MIN=0
STEP_MAX=7
POLL_INTERVAL_S=60
ZERO_THRESHOLD_KW=0.05

# History database location
DB_PATH=data/askoheat.db
